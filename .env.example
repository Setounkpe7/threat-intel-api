# Application
APP_NAME=threat-intel-api
# APP_ENV: dev | prod
APP_ENV=dev
LOG_LEVEL=INFO

# Database connection (asyncpg in prod, aiosqlite in dev/tests)
DATABASE_URL=postgresql+asyncpg://threat:threat@db:5432/threat_intel

# CORS allowlist (comma-separated origins; empty = no cross-origin)
CORS_ORIGINS=http://localhost:3000

# NVD collector
NVD_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
# NVD_API_KEY is optional. Leave blank for anonymous rate limits (5 req / 30 s).
NVD_API_KEY=
NVD_FETCH_INTERVAL_MINUTES=60
