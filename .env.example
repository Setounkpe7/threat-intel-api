# Application
APP_NAME=threat-intel-api
# APP_ENV: dev | prod
APP_ENV=dev
LOG_LEVEL=INFO

# Database connection (asyncpg in prod, aiosqlite in dev/tests)
DATABASE_URL=postgresql+asyncpg://threat:threat@db:5432/threat_intel

# CORS allowlist (comma-separated origins; empty = no cross-origin)
CORS_ORIGINS=http://localhost:3000

# NVD collector
NVD_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
# NVD_API_KEY is optional. Leave blank for anonymous rate limits (5 req / 30 s).
NVD_API_KEY=
NVD_FETCH_INTERVAL_MINUTES=60

# Sector profiles directory (relative to working dir or absolute)
PROFILES_PATH=profiles

# Admin API key for /api/v1/admin/* endpoints (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
ADMIN_API_KEY=

# Public-endpoint rate limit
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_ENABLED=true

# Sentry error tracking (errors only, no tracing). Leave SENTRY_DSN
# blank to disable; the DSN is provided by your Sentry project's
# Settings > Client Keys page.
SENTRY_DSN=
SENTRY_ENVIRONMENT=prod

# GitHub Security Advisories collector (M3a). Optional.
# Generate at https://github.com/settings/tokens — no scope required for public advisories.
# Without this set, the collector is disabled at startup.
GITHUB_TOKEN=
